# Copy this file to .env and add your OpenRouter key.
OPENROUTER_API_KEY=your-openrouter-key-here

# Image-capable free models are tried in order when a provider is busy or unavailable.
OPENROUTER_VISION_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Optional: Set this if COLMAP is not available on your system PATH.
# COLMAP_EXE=/path/to/colmap
